<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mUczen.Views.SchedulePage"
             Title="Plan lekcji">

    <Grid RowDefinitions="Auto,*" Padding="20">
        <HorizontalStackLayout Grid.Row="0" x:Name="DayTabs" Spacing="8" Margin="0,10,0,10"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="LessonsList" Spacing="10"/>
        </ScrollView>
    </Grid>
</ContentPage>