<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             x:Class="mUczen.Views.LoginPage">

    <Grid BackgroundColor="{StaticResource Porcelain}"
          RowDefinitions="*,Auto,Auto"
          x:Name="MainGrid">

        <!-- DEKORACJE TŁA -->
        <Ellipse
            WidthRequest="180"
            HeightRequest="180"
            Fill="{StaticResource Cerulean}"
            Opacity="0.08"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="-70,-50,0,0"
            InputTransparent="True"/>
        <Ellipse
            WidthRequest="110"
            HeightRequest="110"
            Fill="{StaticResource Cerulean}"
            Opacity="0.06"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,90,-40,0"
            InputTransparent="True"/>
        <Ellipse
            WidthRequest="130"
            HeightRequest="130"
            Fill="{StaticResource Cerulean}"
            Opacity="0.06"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,-40,-30"
            InputTransparent="True"/>

        <!-- TOP -->
        <VerticalStackLayout
            x:Name="TopSection"
            Grid.Row="0"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="12">
            <!-- LOGO -->
            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="18"
                WidthRequest="220"
                HeightRequest="220"
                HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="110"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.10"
                        Radius="20"
                        Offset="0,8"/>
                </Border.Shadow>
                <Image
                    x:Name="Logo"
                    Loaded="Animate_Logo"
                    Unloaded="Stop_Logo"
                    Source="student_logo_placeholder.png"
                    Aspect="AspectFit"/>
            </Border>
            <Label
                Text="mUczeń"
                FontSize="34"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{StaticResource CharcoalBrown}"/>
            <Label
                Text="Twoja nauka. W jednym miejscu."
                FontSize="15"
                HorizontalOptions="Center"
                TextColor="{StaticResource CharcoalBrown}"
                Opacity="0.65"/>
        </VerticalStackLayout>

        <!-- BOTTOM -->
        <VerticalStackLayout
            x:Name="BottomSection"
            Grid.Row="2"
            Spacing="12"
            Padding="20,15,20,30"
            HorizontalOptions="Center">

            <Button
                x:Name="LoginButton"
                Text="Zaloguj się"
                TextColor="White"
                BackgroundColor="{StaticResource Cerulean}"
                CornerRadius="12"
                WidthRequest="300"
                HeightRequest="52"
                FontSize="16"
                FontAttributes="Bold"
                Clicked="DisplayLoginPopup">
                <Button.Shadow>
                    <Shadow
                        Brush="{StaticResource Cerulean}"
                        Opacity="0.35"
                        Radius="14"
                        Offset="0,6"/>
                </Button.Shadow>
            </Button>

            <Button
                x:Name="RegisterButton"
                Text="Utwórz konto"
                Clicked="DisplayRegisterPopup"
                BorderColor="{StaticResource CharcoalBrown}"
                BorderWidth="1"
                BackgroundColor="Transparent"
                CornerRadius="12"
                WidthRequest="300"
                HeightRequest="52"
                FontSize="16"
                TextColor="{StaticResource CharcoalBrown}"/>

            <Label
                Text="© 2026 mUczeń"
                FontSize="11"
                HorizontalOptions="Center"
                TextColor="{StaticResource CharcoalBrown}"
                Opacity="0.4"
                Margin="0,5,0,0"/>

        </VerticalStackLayout>

        <!-- LOGIN POPUP -->
        <Grid
            x:Name="LoginPopup"
            Grid.RowSpan="3"
            RowDefinitions="Auto,*"
            BackgroundColor="{StaticResource Cerulean}"
            IsVisible="False">

            <Ellipse
                WidthRequest="220"
                HeightRequest="220"
                Fill="White"
                Opacity="0.07"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,-70,-80,0"
                InputTransparent="True"/>
            <Ellipse
                Grid.RowSpan="2"
                WidthRequest="160"
                HeightRequest="160"
                Fill="White"
                Opacity="0.06"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="-60,0,0,-40"
                InputTransparent="True"/>

            <Button
                Grid.Row="0"
                Text="‹  Wróć"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="16"
                HorizontalOptions="Start"
                Margin="10,10,0,0"
                Clicked="CloseLoginPopup"/>

            <ScrollView Grid.Row="1" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" Padding="20" HorizontalOptions="Center">

                    <Label
                        Text="Witaj ponownie!"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="Zaloguj się numerem legitymacji"
                        FontSize="14"
                        TextColor="White"
                        Opacity="0.8"
                        HorizontalOptions="Center"
                        Margin="0,0,0,15"/>

                    <Label
                        Text="Numer legitymacji"
                        TextColor="White"
                        FontSize="13"
                        Opacity="0.85"
                        Margin="4,0,0,0"/>
                    <Border
                        WidthRequest="300"
                        HeightRequest="52"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Entry
                            x:Name="StudentIdCardEntry"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource CharcoalBrown}"
                            PlaceholderColor="Grey"
                            VerticalOptions="Center"
                            Margin="12,0,0,0"
                            Placeholder="Numer legitymacji"
                            Keyboard="Numeric"
                            ReturnType="Next"
                            Completed="EntryCompleted"/>
                    </Border>

                    <Label
                        Text="Hasło"
                        TextColor="White"
                        FontSize="13"
                        Opacity="0.85"
                        Margin="4,6,0,0"/>
                    <Border
                        WidthRequest="300"
                        HeightRequest="52"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="PasswordEntry"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource CharcoalBrown}"
                                PlaceholderColor="Grey"
                                VerticalOptions="Center"
                                Margin="12,0,0,0"
                                Placeholder="Hasło"
                                IsPassword="True"
                                ReturnType="Done"
                                Completed="EntryCompleted"/>
                            <Label
                                x:Name="LoginShowPasswordLabel"
                                Grid.Column="1"
                                Text="Pokaż"
                                TextColor="{StaticResource Cerulean}"
                                FontSize="13"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                Margin="8,0,14,0">
                                <!-- TODO: zaimplementować TapGestureRecognizer (TogglePasswordVisibility) -->
                            </Label>
                        </Grid>
                    </Border>

                    <Button
                        Text="Zaloguj się"
                        BackgroundColor="{StaticResource Porcelain}"
                        BorderColor="{StaticResource CharcoalBrown}"
                        TextColor="{StaticResource CharcoalBrown}"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        CornerRadius="12"
                        WidthRequest="300"
                        HeightRequest="52"
                        Margin="0,15,0,0"
                        Clicked="LoginButtonClicked"/>

                    <Label HorizontalOptions="Center" Margin="0,10,0,0" TextColor="White" FontSize="14">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Nie masz konta? "/>
                                <Span Text="Utwórz je" FontAttributes="Bold" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <!-- TODO: zaimplementować TapGestureRecognizer (SwitchToRegister) -->
                    </Label>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- REGISTER POPUP -->
        <Grid
            x:Name="RegisterPopup"
            Grid.RowSpan="3"
            RowDefinitions="Auto,*"
            BackgroundColor="{StaticResource Cerulean}"
            IsVisible="False">

            <Ellipse
                WidthRequest="220"
                HeightRequest="220"
                Fill="White"
                Opacity="0.07"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="-90,-70,0,0"
                InputTransparent="True"/>
            <Ellipse
                Grid.RowSpan="2"
                WidthRequest="160"
                HeightRequest="160"
                Fill="White"
                Opacity="0.06"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,-60,-40"
                InputTransparent="True"/>

            <Button
                Grid.Row="0"
                Text="‹  Wróć"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="16"
                HorizontalOptions="Start"
                Margin="10,10,0,0"
                Clicked="CloseRegisterPopup"/>

            <ScrollView Grid.Row="1" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12" Padding="20" HorizontalOptions="Center">

                    <Label
                        Text="Utwórz konto"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="Uzupełnij dane i zacznij korzystać z mUczenia"
                        FontSize="14"
                        TextColor="White"
                        Opacity="0.8"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        WidthRequest="300"
                        Margin="0,0,0,10"/>

                    <Label
                        Text="Imię"
                        TextColor="White"
                        FontSize="13"
                        Opacity="0.85"
                        Margin="4,0,0,0"/>
                    <Border
                        WidthRequest="300"
                        HeightRequest="52"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Entry
                            x:Name="CreateAccountFirstName"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource CharcoalBrown}"
                            PlaceholderColor="Grey"
                            VerticalOptions="Center"
                            Margin="12,0,0,0"
                            Keyboard="Text"
                            Placeholder="Imię"
                            ReturnType="Next"
                            Completed="EntryCompleted"/>
                    </Border>

                    <Label
                        Text="Nazwisko"
                        TextColor="White"
                        FontSize="13"
                        Opacity="0.85"
                        Margin="4,6,0,0"/>
                    <Border
                        WidthRequest="300"
                        HeightRequest="52"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Entry
                            x:Name="CreateAccountLastName"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource CharcoalBrown}"
                            PlaceholderColor="Grey"
                            VerticalOptions="Center"
                            Margin="12,0,0,0"
                            Keyboard="Text"
                            Placeholder="Nazwisko"
                            ReturnType="Next"
                            Completed="EntryCompleted"/>
                    </Border>

                    <Label
                        Text="Numer legitymacji"
                        TextColor="White"
                        FontSize="13"
                        Opacity="0.85"
                        Margin="4,6,0,0"/>
                    <Border
                        WidthRequest="300"
                        HeightRequest="52"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Entry
                            x:Name="CreateAccountStudentIdCardEntry"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource CharcoalBrown}"
                            PlaceholderColor="Grey"
                            VerticalOptions="Center"
                            Margin="12,0,0,0"
                            Keyboard="Numeric"
                            Placeholder="Numer legitymacji"
                            ReturnType="Next"
                            Completed="EntryCompleted"/>
                    </Border>

                    <Label
                        Text="Hasło"
                        TextColor="White"
                        FontSize="13"
                        Opacity="0.85"
                        Margin="4,6,0,0"/>
                    <Border
                        WidthRequest="300"
                        HeightRequest="52"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="CreateAccountPasswordEntry"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource CharcoalBrown}"
                                PlaceholderColor="Grey"
                                VerticalOptions="Center"
                                Margin="12,0,0,0"
                                Keyboard="Default"
                                IsPassword="True"
                                Placeholder="Hasło"
                                ReturnType="Done"
                                Completed="EntryCompleted"/>
                            <Label
                                x:Name="RegisterShowPasswordLabel"
                                Grid.Column="1"
                                Text="Pokaż"
                                TextColor="{StaticResource Cerulean}"
                                FontSize="13"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                Margin="8,0,14,0">
                                <!-- TODO: zaimplementować TapGestureRecognizer (TogglePasswordVisibility) -->
                            </Label>
                        </Grid>
                    </Border>
                    <Label
                        Text="Hasło powinno mieć co najmniej 8 znaków"
                        FontSize="12"
                        TextColor="White"
                        Opacity="0.7"
                        Margin="4,-6,0,0"/>

                    <Button
                        Text="Utwórz konto"
                        BackgroundColor="{StaticResource Porcelain}"
                        BorderColor="{StaticResource CharcoalBrown}"
                        TextColor="{StaticResource CharcoalBrown}"
                        FontSize="16"
                        FontAttributes="Bold"
                        BorderWidth="1"
                        CornerRadius="12"
                        WidthRequest="300"
                        HeightRequest="52"
                        Margin="0,10,0,0"
                        Clicked="CreateAccountButtonClicked"/>

                    <Label HorizontalOptions="Center" Margin="0,10,0,0" TextColor="White" FontSize="14">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Masz już konto? "/>
                                <Span Text="Zaloguj się" FontAttributes="Bold" TextDecorations="Underline"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <!-- TODO: zaimplementować TapGestureRecognizer (SwitchToLogin) -->
                    </Label>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
