<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mUczen.Views.HomeworkPage"
             Title="Zadania">

    <Grid RowDefinitions="Auto,*" Padding="20">
        <Label Grid.Row="0" Text="Zadania domowe" FontSize="22" FontAttributes="Bold" Margin="0,10,0,10"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="HomeworkList" Spacing="10"/>
        </ScrollView>
    </Grid>
</ContentPage>