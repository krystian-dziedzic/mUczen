<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             x:Class="mUczen.Views.MainPage"
             Title="MainPage">
    <Grid ColumnDefinitions="*, *, *" RowDefinitions="*, 2*, *, *, auto" ColumnSpacing="12" RowSpacing="12">
        <!-- CONTENT -->
        <ScrollView
            Margin="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Grid.Row="0"
            Grid.RowSpan="4"
            HorizontalOptions="Center">
            <!-- WIDGETS CONTAINER -->
            <VerticalStackLayout>
                <!-- HELLO WIDGET -->
                <!-- PLACEHOLDER VALUES INSIDE CHANGE LATER -->
                <FlexLayout
                    JustifyContent="SpaceBetween">
                    <VerticalStackLayout
                        Padding="20,20">
                        <Label 
                            Text="Cześć," 
                            FontSize="Large"/>
                        <Label 
                            x:Name="UserFirstName"
                            Text="Wojciech!"
                            FontSize="Large"
                            FontAttributes="Bold"/>
                        <Label 
                            x:Name="UserClassName"
                            FontSize="Medium"
                            Text="4TPa"/>
                    </VerticalStackLayout>
                    <!-- INSERT MUCZEN LOGO HERE -->
                    <Image
                        Source="student_logo_placeholder.png"
                        HeightRequest="100"
                        WidthRequest="100"/>
                </FlexLayout>
                <!-- STUDENT ID VISUALIZATION -->
                <!-- PLACEHOLDER VALUES ChANGE LATER -->
                <Border
                    Grid.Column="0"
                    Grid.Row="1"
                    Stroke="{StaticResource CharcoalBrown}"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="MediumSpringGreen">
                    <FlexLayout
                        HeightRequest="230"
                        JustifyContent="SpaceEvenly"
                        AlignItems="Center">
                        <Border
                            StrokeShape="RoundRectangle 10">
                            <Image
                            Source="placeholder.jpg"
                                MaximumHeightRequest="150"/>
                        </Border>
                        <VerticalStackLayout
                            Spacing="10">
                            <Label
                                Text="Legitymacja uczniowska"
                                FontSize="Medium"/>
                            <Label Text="Wojciech Kapera"
                                FontSize="Large"
                                FontAttributes="Bold"/>
                            <Label 
                                MaximumWidthRequest="200"
                                Text="Zespół szkół technicznych"/>
                            <Label 
                                Text="Nr legitymacji:"/>
                            <Label 
                                Text="213769420"/>
                        </VerticalStackLayout>
                    </FlexLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <!-- FIXED HOME DOCK -->
        <HorizontalStackLayout 
            Grid.Row="5" 
            Grid.Column="0" 
            Grid.ColumnSpan="3"
            Padding="20,15,20,30">
            <Label
                Text="TEST"/>
        </HorizontalStackLayout>
    </Grid> 
</ContentPage>