<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             x:Class="mUczen.Views.MainPage"
             Title="MainPage">

    <Grid RowDefinitions="*,Auto">

        <!-- CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">

                <!-- HEADER ( PLACEHOLDER DATA ) -->
                <Grid ColumnDefinitions="*,Auto" Padding="20,20,20,0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Cześć," FontSize="Large"/>
                        <Label x:Name="UserFirstName"
                               Text="Wojciech!"
                               FontSize="Large"
                               FontAttributes="Bold"/>
                        <Label x:Name="UserClassName"
                               Text="4TPa"
                               FontSize="Medium"/>
                    </VerticalStackLayout>

                    <Image Grid.Column="1"
                           Source="student_logo_placeholder.png"
                           HeightRequest="100"
                           WidthRequest="100"/>
                </Grid>

                <!-- STUDENT ID CARD ( PLACEHOLDER DATA ) -->
                <Border Margin="20,0"
                        Stroke="{StaticResource CharcoalBrown}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="MediumSpringGreen">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          Padding="16"
                          HeightRequest="230">

                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Center">
                            <Image Source="placeholder.jpg"
                                   MaximumHeightRequest="150"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="10"
                                             VerticalOptions="Center">
                            <Label Text="Legitymacja uczniowska" FontSize="Medium"/>
                            <Label Text="Wojciech Kapera"
                                   FontSize="Large"
                                   FontAttributes="Bold"/>
                            <Label Text="Zespół szkół technicznych"/>
                            <Label Text="Nr legitymacji:"/>
                            <Label Text="213769420"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- MORE -->

            </VerticalStackLayout>
        </ScrollView>

        <!-- DOCK -->
        <HorizontalStackLayout Grid.Row="1" Padding="20,15,20,30">
            <Label Text="TEST"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>