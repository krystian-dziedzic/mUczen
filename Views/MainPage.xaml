<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             x:Class="mUczen.Views.MainPage"
             Title="MainPage">

    <Grid RowDefinitions="*,Auto">

        <!-- CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10">

                <!-- HEADER ( PLACEHOLDER DATA ) -->
                <Grid ColumnDefinitions="*,Auto" Padding="20,20,20,0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Cześć," FontSize="Large"/>
                        <Label x:Name="UserFirstName"
                               Text="Wojciech!"
                               FontSize="Large"
                               FontAttributes="Bold"/>
                        <Label x:Name="UserClassName"
                               Text="4TPa"
                               FontSize="Medium"/>
                    </VerticalStackLayout>

                    <Image Grid.Column="1"
                           Source="student_logo_placeholder.png"
                           HeightRequest="100"
                           WidthRequest="100"/>
                </Grid>

                <!-- STUDENT ID CARD ( PLACEHOLDER DATA ) -->
                <Border Margin="20,0"
                        Stroke="{StaticResource CharcoalBrown}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource Porcelain}">
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.10"
                            Radius="20"
                            Offset="0,8"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto, *"
                          RowSpacing="16"
                          ColumnSpacing="16"
                          Padding="16"
                          HeightRequest="230">

                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Center">
                            <Image Source="placeholder.jpg" MaximumHeightRequest="150"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="10"
                                             VerticalOptions="Center">

                            <Label Text="Legitymacja uczniowska" FontSize="Medium"/>
                            <Label Text="Wojciech Kapera" FontSize="Large" FontAttributes="Bold"/>
                            <Label Text="Zespół szkół technicznych"/>
                            <Label Text="Nr legitymacji:"/>
                            <Label Text="213769420"/>

                        </VerticalStackLayout>

                        <Border 
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Grid.Row="1"
                            StrokeShape="RoundRectangle 10">
                            <Label
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Text="WAŻNA DO: 10.10.2100"/>
                        </Border>
                    </Grid>
                </Border>
                <!-- GRID MENU BUTTONS ( NOT WORKING YET ) -->
                <Grid
                    ColumnDefinitions="*, *, *"
                    RowDefinitions="*, *"
                    Margin="20,0"
                    RowSpacing="10"
                    ColumnSpacing="10">
                    <Border
                        Grid.Column="0"
                        Grid.Row="0"
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                        </Border.Shadow>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                            <!-- IMPLEMENT GESTURE RECOGNIZER -->
                            <Image Source="grades.svg"
                                HeightRequest="70"
                                WidthRequest="70"/>
                            <Label
                                HorizontalOptions="Center"
                                Text="Oceny"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Grid.Row="0"
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                        </Border.Shadow>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="10">
                            <!-- IMPLEMENT GESTURE RECOGNIZER -->
                            <Image Source="abscence.svg"
                                HeightRequest="70"
                                WidthRequest="70"/>
                            <Label
                                Text="Frekwencja"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Grid.Row="0"
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                        </Border.Shadow>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <!-- IMPLEMENT GESTURE RECOGNIZER -->
                            <Image Source="lessons.svg"
                                HeightRequest="70"
                                WidthRequest="70"/>
                            <Label
                                HorizontalOptions="Center"
                                Text="Plan lekcji"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="0"
                        Grid.Row="1"                        
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                        </Border.Shadow>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <!-- IMPLEMENT GESTURE RECOGNIZER -->
                            <Image Source="homework.svg"
                                HeightRequest="70"
                                WidthRequest="70"/>
                            <Label
                                Text="Zadania"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Grid.Row="1"                        
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                        </Border.Shadow>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="10">
                            <!-- IMPLEMENT GESTURE RECOGNIZER -->
                            <Image Source="announcements.svg"
                                HeightRequest="70"
                                WidthRequest="70"/>
                            <Label
                                Text="Komunikaty"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Grid.Row="1"                        
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                        </Border.Shadow>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <!-- IMPLEMENT GESTURE RECOGNIZER -->
                            <Image Source="more.svg"
                                HeightRequest="70"
                                WidthRequest="70"/>
                            <Label
                                HorizontalOptions="Center"
                                Text="Więcej"
                                FontAttributes="Bold"
                                FontSize="16"
                                LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- UPCOMING WIDGET ( PLACEHOLDER DATA ) -->
                <Border Margin="20,0,20,20"
                        Padding="16"
                        Stroke="{StaticResource CharcoalBrown}"
                        BackgroundColor="{StaticResource Porcelain}"
                        StrokeShape="RoundRectangle 20">
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.10"
                            Radius="20"
                            Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Nadchodzące"
                               FontSize="Medium"
                               FontAttributes="Bold"/>

                        <!-- ITEM: NEXT LESSON -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource Cerulean}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Matematyka" FontAttributes="Bold"/>
                                <Label Text="Lekcja · sala 12" FontSize="12" Opacity="0.65"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="08:00" FontAttributes="Bold" HorizontalOptions="End"/>
                                <Label Text="Dzisiaj" FontSize="12" Opacity="0.65" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CharcoalBrown}" Opacity="0.15"/>

                        <!-- ITEM: TEST -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource CharcoalBrown}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Sprawdzian z fizyki" FontAttributes="Bold"/>
                                <Label Text="Dział: Dynamika" FontSize="12" Opacity="0.65"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="Jutro" FontAttributes="Bold" HorizontalOptions="End"/>
                                <Label Text="10:00" FontSize="12" Opacity="0.65" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CharcoalBrown}" Opacity="0.15"/>

                        <!-- ITEM: HOMEWORK -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     CornerRadius="2"
                                     Color="{StaticResource CharcoalBrown}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Zadanie z j. polskiego" FontAttributes="Bold"/>
                                <Label Text="Rozprawka" FontSize="12" Opacity="0.65"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="Piątek" FontAttributes="Bold" HorizontalOptions="End"/>
                                <Label Text="Termin" FontSize="12" Opacity="0.65" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DOCK ( NOT WORKING YET ) -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Porcelain}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20,20,0,0"
                Padding="10,12,10,30">
            <Border.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.10"
                    Radius="20"
                    Offset="0,-4"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*,*">

                <!-- HOME ( SELECTED ) -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <!-- IMPLEMENT GESTURE RECOGNIZER -->
                    <!-- INSERT ICON -->
                    <Image WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"/>
                    <Label Text="Główna"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Cerulean}"
                           HorizontalOptions="Center"
                           LineBreakMode="NoWrap"/>
                </VerticalStackLayout>

                <!-- GRADES -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <!-- IMPLEMENT GESTURE RECOGNIZER -->
                    <!-- INSERT ICON -->
                    <Image WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"/>
                    <Label Text="Oceny"
                           FontSize="11"
                           TextColor="{StaticResource CharcoalBrown}"
                           Opacity="0.6"
                           HorizontalOptions="Center"
                           LineBreakMode="NoWrap"/>
                </VerticalStackLayout>

                <!-- TIMETABLE -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <!-- IMPLEMENT GESTURE RECOGNIZER -->
                    <!-- INSERT ICON -->
                    <Image WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"/>
                    <Label Text="Plan"
                           FontSize="11"
                           TextColor="{StaticResource CharcoalBrown}"
                           Opacity="0.6"
                           HorizontalOptions="Center"
                           LineBreakMode="NoWrap"/>
                </VerticalStackLayout>
                
                <!-- HOMEWORK -->
                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <!-- IMPLEMENT GESTURE RECOGNIZER -->
                    <!-- INSERT ICON -->
                    <Image WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"/>
                    <Label Text="Zadania"
                           FontSize="11"
                           TextColor="{StaticResource CharcoalBrown}"
                           Opacity="0.6"
                           HorizontalOptions="Center"
                           LineBreakMode="NoWrap"/>
                </VerticalStackLayout>

                <!-- MORE -->
                <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                    <!-- IMPLEMENT GESTURE RECOGNIZER -->
                    <!-- INSERT ICON -->
                    <Image WidthRequest="26" HeightRequest="26" HorizontalOptions="Center"/>
                    <Label Text="Więcej"
                           FontSize="11"
                           TextColor="{StaticResource CharcoalBrown}"
                           Opacity="0.6"
                           HorizontalOptions="Center"
                           LineBreakMode="NoWrap"/>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
