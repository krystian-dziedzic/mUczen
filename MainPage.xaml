<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mUczen.MainPage"
             Shell.NavBarIsVisible="False">
    <!--
    Colors:
    
    Charcoal Brown #363732
    Cerulean #007EA7
    Porcelain #F1F5F2
    -->
    <VerticalStackLayout Spacing="5" Padding="5" BackgroundColor="#F1F5F2">
        <VerticalStackLayout>
            <!--PLACEHOLDER--><Image Source="student_logo_placeholder.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Center"/>
            <Label
                Text="mUczeń"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>
        
        <VerticalStackLayout Spacing="10" VerticalOptions="End" HorizontalOptions="Center">
            <Button
                Text="Zaloguj się"
                BackgroundColor="#007EA7"
                CornerRadius="10"
                WidthRequest="300"/>
            <Button
                Text="Utwórz konto"
                BorderColor="#363732"
                BorderWidth="1"
                BackgroundColor="#F1F5F2"
                CornerRadius="10"
                WidthRequest="300"
                TextColor="#363732"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
